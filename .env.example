# Kopyala: cp .env.example .env  — .env asla commit edilmez.
GEMINI_API_KEY=buraya-yeni-anahtar
# İzinli kaynaklar (virgülle). Boş bırakılırsa varsayılan: furkansenyuz.com, www.furkansenyuz.com, furkansenyuz.github.io
ALLOWED_ORIGINS=
# IP başına 15 dakikalık istek sınırı
RATE_LIMIT_PER_IP=20
# Günlük toplam istek tavanı
DAILY_LIMIT=300
MAX_OUTPUT_TOKENS=600
PORT=3000
